# Public values only — everything here ships to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Leave empty when the API serves the web app (same origin). Otherwise e.g. https://api.applyflux.example
VITE_API_URL=
# Chrome extension id (enables one-click pairing from the web app) and its store listing, when published.
VITE_EXTENSION_ID=
VITE_EXTENSION_STORE_URL=
