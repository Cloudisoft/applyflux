{
  "name": "applyflux",
  "private": true,
  "version": "0.1.0",
  "description": "ApplyFlux by Cloudisoft \u2014 AI-powered job application automation",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @applyflux/server --filter @applyflux/web dev",
    "build": "pnpm --filter @applyflux/web build && pnpm --filter @applyflux/server build && pnpm --filter @applyflux/extension build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=!@applyflux/e2e test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:migrate": "node apps/server/dist/migrate.js",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}