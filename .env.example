# ─── ApplyFlux API (apps/server) — server-side secrets. Never ship these to the browser or extension. ───
NODE_ENV=production
PORT=3001
# Public URL of this API (used for signed download links and the Sandbox). On Railway, defaults to https://$RAILWAY_PUBLIC_DOMAIN.
PUBLIC_API_URL=http://localhost:3001
# Origins of the web app (comma separated). Same origin as the API when the API serves the web build. On Railway, defaults to the public domain.
WEB_ORIGINS=http://localhost:5173
# chrome-extension://<id> of your published ApplyFlux Agent (comma separated). Empty = any extension origin (dev only).
EXTENSION_ORIGINS=

# Supabase → Project Settings → Database → Connection string (use the pooler URI on serverless hosts)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase → Project Settings → API → service_role key (server only)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 JWT secret. When empty, tokens are verified against the project's JWKS.
SUPABASE_JWT_SECRET=
STORAGE_DRIVER=supabase
STORAGE_BUCKET=documents

# AI: openai | openrouter | none
AI_PROVIDER=none
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional model override (defaults: gpt-4o-mini / openai/gpt-4o-mini)
AI_MODEL=

# Platforms where Auto Mode may click Submit. Add a platform only after validating it end to end.
AUTO_SUBMIT_PLATFORMS=sandbox
# Random string, at least 32 characters: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=
# The mock employer used for onboarding test runs. Set to false to disable.
ENABLE_SANDBOX=true

# ─── Web app (apps/web) — public values, baked into the build ───
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_EXTENSION_ID=
VITE_EXTENSION_STORE_URL=

# ─── Extension build (apps/extension) ───
APPLYFLUX_API_URL=http://localhost:3001
APPLYFLUX_WEB_URL=http://localhost:5173
